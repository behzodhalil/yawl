{
  "name": "yawl-watch",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --format=esm --target=es2024 --conditions=workerd,worker,browser --outfile=dist/index.js",
    "test": "vitest run",
    "relay:check": "cd relay && tsc --noEmit -p . && vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261124.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
